---
// 05 · Parte con fotos (§2.5). Dueño: WP5. Segunda mitad de la banda de papel.
// A la izquierda el H2 y su entrada; a la derecha la hoja del parte, impresa
// en Overpass Mono con filete de 1 px. Las cuatro fotos las hace la propia web
// (capitulos/parte.ts pide `capturar('parte.A'…)` a la escena de WP2); sin
// WebGL, cada hueco muestra un recorte de MotoLinea. La fecha y la hora son
// las del visitante y se rellenan en el cliente: sin JS queda la plantilla.
import MotoLinea from './svg/MotoLinea.astro';

const fotos = [
  { letra: 'A', pie: 'A · Delantera ¾ izq.', vista: 'delantera tres cuartos izquierda', recorte: '690 120 640 480', espejo: false },
  { letra: 'B', pie: 'B · Trasera ¾ izq.', vista: 'trasera tres cuartos izquierda', recorte: '70 120 640 480', espejo: false },
  { letra: 'C', pie: 'C · Trasera ¾ dcha.', vista: 'trasera tres cuartos derecha', recorte: '70 120 640 480', espejo: true },
  { letra: 'D', pie: 'D · Delantera ¾ dcha.', vista: 'delantera tres cuartos derecha', recorte: '690 120 640 480', espejo: true },
];
---
<section id="parte" class="cap papel cap--flujo parte-cap" data-cap="parte" aria-labelledby="parte-h" data-revelar-stagger="0.08">
  <div class="rejilla parte">
    <div class="parte__texto">
      <h2 id="parte-h" class="h2">Cuatro fotos al cargar y cuatro al entregar.</h2>
      <p class="entrada parte__entrada">Te enviamos el parte en PDF, con hora y firma, para comparar cómo salió la moto y cómo llegó.</p>
    </div>

    <article class="parte__hoja" aria-label="Parte de estado de ejemplo">
      <header class="parte__cabecera">
        <p class="parte__titulo">PARTE DE ESTADO · CARGA</p>
        <p class="parte__num">Nº 0001 · Ejemplo</p>
        <p class="parte__lugar">Madrid · <time class="parte__fecha" data-parte-fecha>dd-mm-aaaa</time> · <span class="parte__hora" data-parte-hora>hh:mm</span></p>
      </header>

      <div class="parte__fotos">
        {fotos.map((f, k) => (
          <figure class="parte__foto" data-k={String(k)} data-revelar="mascara">
            <div class="parte__marco">
              <div class:list={['parte__dibujo', { 'parte__dibujo--espejo': f.espejo }]} aria-hidden="true">
                <MotoLinea viewBox={f.recorte} plataformaY={0} conCalzo etiqueta={`Dibujo de ejemplo, vista ${f.vista}`} />
              </div>
              <img
                alt={`Foto ${f.letra} de ejemplo: moto sobre la plataforma, vista ${f.vista}, con la hora de carga`}
                width="480" height="360" decoding="async"
              />
            </div>
            <figcaption class="parte__pie">{f.pie}<span class="parte__ejemplo"> · Dibujo de ejemplo</span></figcaption>
          </figure>
        ))}
      </div>

      <div class="parte__pie-hoja">
        <div class="parte__entrega">
          <p class="parte__rotulo">ENTREGA · mismos cuatro ángulos</p>
          <div class="parte__huecos" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
          <p class="parte__vacio">Se rellenan al entregar.</p>
        </div>

        <div class="parte__firma">
          <p class="parte__rotulo">Firma</p>
          <svg class="parte__rubrica" viewBox="0 0 220 70" role="img" aria-label="Firma de ejemplo">
            <path d="M8 48C20 20 34 14 30 40S22 62 40 46C52 34 58 30 60 44C62 56 70 50 78 38C84 30 90 34 88 44C86 54 96 52 104 40C110 32 118 30 118 42C118 50 126 50 134 42L146 30C150 26 154 30 150 40C146 52 160 50 176 36C190 26 204 28 212 30" />
            <path d="M22 60C70 55 140 57 204 50" />
          </svg>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  /* Continúa la banda de #cargas: aire mínimo de sección arriba, no el doble. */
  .parte-cap { padding-top: max(100px, var(--e-4)); }
  @media (min-width: 1024px) { .parte-cap { padding-top: max(140px, var(--e-4)); } }

  .parte { row-gap: var(--e-2); align-items: start; }
  .parte__texto { grid-column: 1 / -1; }
  .parte__entrada { margin-top: var(--e-1); color: var(--tinta); }
  .parte__hoja { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .parte__texto { grid-column: 1 / 6; }
    .parte__hoja { grid-column: 6 / 13; }
  }

  /* — la hoja: todo en la letra de cifras, como un albarán impreso — */
  .parte__hoja {
    font-family: var(--f-cifras);
    font-size: var(--t-cifra);
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    color: var(--tinta);
    border: 1px solid var(--tinta-2);
    border-radius: var(--r-m);
    padding: clamp(1rem, .6rem + 1.4vw, 2rem);
    display: grid;
    gap: clamp(1rem, .6rem + 1.2vw, 1.75rem);
  }
  .parte__cabecera {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: .25rem 1rem;
    padding-bottom: .9rem;
    border-bottom: 1px solid var(--tinta-2);
  }
  .parte__titulo { font-weight: 600; letter-spacing: .04em; }
  .parte__num { text-align: right; color: var(--tinta-2); }
  .parte__lugar { grid-column: 1 / -1; color: var(--tinta-2); }
  @media (max-width: 479px) {
    .parte__cabecera { grid-template-columns: 1fr; }
    .parte__num { text-align: left; }
  }

  .parte__fotos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(.75rem, .4rem + 1vw, 1.25rem);
  }
  .parte__foto { display: grid; gap: .4rem; }
  .parte__marco {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--tinta-2);
    background: color-mix(in srgb, var(--tinta) 5%, var(--papel));
  }
  .parte__marco img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transition: opacity .2s var(--ease);
  }
  .parte__marco img.cargada { opacity: 1; }
  .parte__dibujo { position: absolute; inset: 0; display: none; color: var(--tinta); }
  .parte__dibujo :global(svg) { width: 100%; height: 100%; }
  .parte__dibujo--espejo { transform: scaleX(-1); }
  :global(html.fuente-svg) .parte__foto:not(.con-foto) .parte__dibujo { display: block; }
  .parte__pie { font-size: .8125rem; color: var(--tinta); }
  .parte__ejemplo { display: none; color: var(--tinta-2); }
  :global(html.fuente-svg) .parte__foto:not(.con-foto) .parte__ejemplo { display: inline; }

  .parte__rotulo { font-weight: 600; letter-spacing: .04em; font-size: .8125rem; }
  /* Entrega y firma comparten la última franja de la hoja, separadas por un filete. */
  .parte__pie-hoja {
    display: grid;
    gap: 1.25rem;
    padding-top: .9rem;
    border-top: 1px solid var(--tinta-2);
  }
  @media (min-width: 640px) {
    .parte__pie-hoja { grid-template-columns: minmax(0, 1fr) minmax(0, 13rem); gap: 0; }
    .parte__firma { padding-left: 1.25rem; border-left: 1px solid var(--tinta-2); }
  }
  .parte__entrega { display: grid; gap: .6rem; align-content: start; padding-right: 1.25rem; }
  .parte__huecos { display: grid; grid-template-columns: repeat(4, minmax(0, 5.5rem)); gap: .6rem; }
  .parte__huecos span { aspect-ratio: 4 / 3; border: 1px dashed var(--tinta-2); }
  .parte__vacio { color: var(--tinta-2); font-size: .8125rem; }
  .parte__firma { display: grid; gap: .6rem; align-content: start; }
  .parte__rubrica { width: 100%; height: auto; }
  .parte__rubrica path {
    fill: none; stroke: var(--tinta); stroke-width: 1.4px;
    stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke;
  }
</style>
