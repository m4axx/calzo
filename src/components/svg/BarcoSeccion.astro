---
// Lámina del barco en sección sobre su cuna (§5.5). Dueño: WP5. viewBox 0 0 400 300.
// Contrato de props:
//   mini?: boolean    versión de la mini-lámina del panel de precio (WP4): trazo
//                     en currentColor, sin rótulos. En mini, el grupo
//                     .barco__casco (casco, pantoques, taco, puntales, cinchas y
//                     cota) se ensancha con scaleX(2,70/2,40) desde x = 200 cuando
//                     <html> tiene la clase `manga-ancha` (la pone WP4), y la cota
//                     pasa de «2,40 m» a «> 2,55 m». Cambio de estado, sin animación.
//   revelar?: boolean añade data-revelar="mascara"
//   class?: string
// La cuna (viga y ruedas) y el límite discontinuo de 2,55 m no se ensanchan:
// son la referencia contra la que se lee que el casco se sale.
interface Props { mini?: boolean; revelar?: boolean; class?: string }
const { mini = false, revelar = false, class: cls } = Astro.props;

// Límite legal dibujado a la escala de la manga: 200 ± (2,55/2,40)·130.
const semi = (2.55 / 2.4) * 130;
const lim0 = 200 - semi;
const lim1 = 200 + semi;
// El casco es recto de la pantoquera a la quilla (la Q tiene el control en su
// extremo): y del costado en x, para apoyar los pantoques justo debajo.
const costado = (x: number) => (x <= 200 ? 170 + (x - 100) * 0.65 : 170 + (300 - x) * 0.65);
const pantoqueI = `125,${costado(125)} 160,${costado(160)} 160,215 125,195`;
const pantoqueD = `240,${costado(240)} 275,${costado(275)} 275,195 240,215`;
// Puntales: de la cara inferior de cada pantoque a la viga.
const bajoI = (x: number) => 195 + ((x - 125) / 35) * 20;
const bajoD = (x: number) => 215 - ((x - 240) / 35) * 20;
const puntales: Array<[number, number]> = [[132, bajoI(132)], [153, bajoI(153)], [247, bajoD(247)], [268, bajoD(268)]];
---
<svg
  class:list={['barco-seccion', { 'barco-seccion--mini': mini }, cls]}
  viewBox="0 0 400 300"
  role="img"
  aria-label="Barco en sección sobre su cuna, apoyado en quilla y pantoques, con la cota de manga"
  data-revelar={revelar ? 'mascara' : undefined}
>
  <!-- límite de 2,55 m: referencia fija -->
  <g class="l-cota l-limite" fill="none">
    <line x1={lim0} y1="44" x2={lim0} y2="262" />
    <line x1={lim1} y1="44" x2={lim1} y2="262" />
    <line x1={lim0} y1="54" x2={lim1} y2="54" />
  </g>
  <text class="l-cifra" x="200" y="48" text-anchor="middle">2,55 m</text>

  {!mini && <line class="l-cota l-eje" x1="200" y1="88" x2="200" y2="268" />}

  <!-- cuna: ruedas detrás de la viga -->
  <g class="l-trazo">
    <circle cx="95" cy="272" r="16" class="l-lleno" />
    <circle cx="305" cy="272" r="16" class="l-lleno" />
    {!mini && <circle cx="95" cy="272" r="4" />}
    {!mini && <circle cx="305" cy="272" r="4" />}
    <rect x="40" y="255" width="320" height="5" class="l-lleno" />
  </g>

  <g class="barco__casco">
    <g class="l-trazo">
      {puntales.map(([x, y]) => <line x1={x} y1={y} x2={x} y2="255" />)}
      <polygon points={pantoqueI} class="l-lleno" />
      <polygon points={pantoqueD} class="l-lleno" />
      <rect x="185" y="235" width="30" height="20" class="l-lleno" />
      <path d="M70 110 L330 110 L300 170 Q200 235 200 235 Q200 235 100 170 Z" class="l-lleno" />
      {!mini && <line class="l-fina" x1="74" y1="117" x2="326" y2="117" />}
      {!mini && <path class="l-fina" d="M100 170 L300 170" />}
    </g>
    <g class="l-cincha">
      <line x1="60" y1="255" x2="70" y2="110" />
      <line x1="340" y1="255" x2="330" y2="110" />
    </g>
    <g class="l-anilla">
      <circle cx="60" cy="255" r="4.5" />
      <circle cx="340" cy="255" r="4.5" />
    </g>
    <!-- cota de manga: 2,40 m -->
    <g class="l-cota" fill="none">
      <line x1="70" y1="106" x2="70" y2="74" />
      <line x1="330" y1="106" x2="330" y2="74" />
      <line x1="70" y1="80" x2="330" y2="80" />
      <line x1="66" y1="84" x2="74" y2="76" />
      <line x1="326" y1="84" x2="334" y2="76" />
    </g>
  </g>
  <text class="l-cifra barco__cota" x="200" y="74" text-anchor="middle">2,40 m</text>
  {mini && <text class="l-cifra barco__cota-ancha" x="200" y="74" text-anchor="middle">&gt; 2,55 m</text>}

  {!mini && (
    <g class="l-rotulo" aria-hidden="true">
      <text x="142" y="292" text-anchor="middle">PANTOQUE</text>
      <line class="l-guia" x1="142" y1="282" x2="142" y2="208" />
      <text x="200" y="284" text-anchor="middle">QUILLA</text>
      <line class="l-guia" x1="200" y1="275" x2="200" y2="250" />
      <text x="258" y="284" text-anchor="middle">CUNA</text>
      <line class="l-guia" x1="258" y1="275" x2="258" y2="260" />
    </g>
  )}
</svg>

<style>
  .barco-seccion {
    --l-trazo: var(--tinta);
    --l-cota: var(--tinta-2);
    --l-fondo: var(--papel);
    --l-cincha: var(--cincha);
    --l-cincha-ancho: 3px;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .barco-seccion--mini {
    --l-trazo: currentColor;
    --l-cota: currentColor;
    --l-fondo: transparent;
    --l-cincha-ancho: 1.5px;
  }
  .barco-seccion :is(rect, line, polygon, circle, path) { vector-effect: non-scaling-stroke; }
  .l-trazo { stroke: var(--l-trazo); stroke-width: 1px; fill: none; }
  .l-trazo .l-lleno { fill: var(--l-fondo); }
  .l-fina { stroke-opacity: .55; }
  .l-cota { stroke: var(--l-cota); stroke-width: 1px; }
  .l-limite { stroke-dasharray: 5 4; }
  .l-eje { stroke-dasharray: 14 3 2 3; }
  .l-cincha { stroke: var(--l-cincha); stroke-width: var(--l-cincha-ancho); }
  .l-anilla { stroke: var(--l-cincha); stroke-width: 1.5px; fill: var(--l-fondo); }
  .l-cifra {
    fill: var(--l-cota);
    font-family: var(--f-cifras);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .l-rotulo {
    fill: var(--l-cota);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 9px;
    letter-spacing: .08em;
  }
  .l-guia { stroke: var(--l-cota); stroke-width: 1px; }

  /* mini + manga > 2,55 m (WP4 pone html.manga-ancha): el casco se sale del límite */
  .barco__casco { transform-box: view-box; transform-origin: 200px 0; }
  .barco__cota-ancha { display: none; }
  :global(html.manga-ancha) .barco-seccion--mini .barco__casco { transform: scaleX(1.125); }
  :global(html.manga-ancha) .barco-seccion--mini .barco__cota { display: none; }
  :global(html.manga-ancha) .barco-seccion--mini .barco__cota-ancha { display: inline; }
</style>
