---
// Lámina del quad en planta (§5.5). Dueño: WP5. viewBox 0 0 400 300, morro a
// la derecha. Coordenadas de la spec, sin redondear: las usa también la
// mini-lámina del panel de precio (WP4). Contrato de props:
//   mini?: boolean    versión de la mini-lámina del panel: todo a 1 px en
//                     currentColor (el panel es oscuro y decide el color),
//                     cinchas en --cincha, sin ejes ni rótulos
//   revelar?: boolean añade data-revelar="mascara" (lámina de #cargas)
//   class?: string
// El trazo es de 1 px de pantalla a cualquier escala (vector-effect), como una
// lámina impresa: la escala cambia el dibujo, no la plumilla.
interface Props { mini?: boolean; revelar?: boolean; class?: string }
const { mini = false, revelar = false, class: cls } = Astro.props;

// Ruedas (60 × 38, rx 8): [x, y] de la esquina superior izquierda.
const ruedas: Array<[number, number]> = [[240, 58], [240, 204], [100, 58], [100, 204]];
// Calzos: trapecios de 12 px, delante de las delanteras y detrás de las traseras.
// El lado largo apoya en la rueda y el corto mira hacia fuera, como una cuña vista desde arriba.
const calzo = (x0: number, x1: number, y: number) =>
  `${x0},${y + 2} ${x1},${y + 7} ${x1},${y + 31} ${x0},${y + 36}`;
const calzos = [calzo(300, 312, 58), calzo(300, 312, 204), calzo(100, 88, 58), calzo(100, 88, 204)];
const anillas: Array<[number, number]> = [[40, 40], [360, 40], [40, 260], [360, 260]];
const cinchas: Array<[number, number, number, number]> = [
  [360, 40, 262, 178], [360, 260, 262, 122], [40, 40, 138, 178], [40, 260, 138, 122],
];
---
<svg
  class:list={['quad-planta', { 'quad-planta--mini': mini }, cls]}
  viewBox="0 0 400 300"
  role="img"
  aria-label="Quad visto desde arriba, atado en cruz con cuatro cinchas y un calzo en cada rueda"
  data-revelar={revelar ? 'mascara' : undefined}
>
  <g class="l-trazo" fill="none">
    <rect x="20" y="20" width="360" height="260" />
    {!mini && <rect class="l-fina" x="26" y="26" width="348" height="248" />}
  </g>

  {!mini && (
    <g class="l-cota" fill="none">
      <line class="l-eje" x1="30" y1="150" x2="370" y2="150" />
      <line class="l-eje" x1="270" y1="44" x2="270" y2="256" />
      <line class="l-eje" x1="130" y1="44" x2="130" y2="256" />
    </g>
  )}

  <g class="l-trazo">
    {ruedas.map(([x, y]) => (
      <g>
        <rect x={x} y={y} width="60" height="38" rx="8" class="l-lleno" />
        {!mini && [12, 22, 32, 42, 52].map((dx) => (
          <line class="l-fina" x1={x + dx} y1={y + 5} x2={x + dx} y2={y + 33} />
        ))}
      </g>
    ))}
    <rect x="130" y="100" width="140" height="100" rx="22" class="l-lleno" />
    {!mini && (
      <g fill="none">
        <rect x="166" y="124" width="62" height="52" rx="14" />
        <line class="l-fina" x1="240" y1="112" x2="240" y2="188" />
        <line class="l-fina" x1="248" y1="110" x2="248" y2="190" />
        <line class="l-fina" x1="256" y1="110" x2="256" y2="190" />
        <line class="l-fina" x1="144" y1="110" x2="144" y2="190" />
        <line class="l-fina" x1="152" y1="112" x2="152" y2="188" />
        <rect x="261" y="98" width="8" height="9" rx="2" />
        <rect x="261" y="193" width="8" height="9" rx="2" />
      </g>
    )}
    <line x1="265" y1="105" x2="265" y2="195" />
    {calzos.map((p) => <polygon points={p} class="l-lleno" />)}
  </g>

  <g class="l-cincha">
    {cinchas.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
  </g>
  <g class="l-anilla">
    {anillas.map(([cx, cy]) => <circle cx={cx} cy={cy} r="6" />)}
  </g>

  {!mini && (
    <g class="l-rotulo" aria-hidden="true">
      <text x="52" y="36">ANILLA</text>
      <line class="l-guia" x1="232" y1="46" x2="304" y2="61" />
      <text x="198" y="48">CALZO</text>
      <text x="304" y="147">CINCHA</text>
      <line class="l-guia" x1="302" y1="144" x2="289" y2="144" />
    </g>
  )}
</svg>

<style>
  .quad-planta {
    --l-trazo: var(--tinta);
    --l-cota: var(--tinta-2);
    --l-fondo: var(--papel);
    --l-cincha: var(--cincha);
    --l-cincha-ancho: 3px;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .quad-planta--mini {
    --l-trazo: currentColor;
    --l-cota: currentColor;
    --l-fondo: transparent;
    --l-cincha-ancho: 1.5px;
  }
  .quad-planta :is(rect, line, polygon, circle) { vector-effect: non-scaling-stroke; }
  .l-trazo { stroke: var(--l-trazo); stroke-width: 1px; fill: none; }
  .l-trazo .l-lleno { fill: var(--l-fondo); }
  .l-fina { stroke-opacity: .55; }
  .l-cota { stroke: var(--l-cota); stroke-width: 1px; }
  .l-eje { stroke-dasharray: 14 3 2 3; }
  .l-cincha { stroke: var(--l-cincha); stroke-width: var(--l-cincha-ancho); stroke-linecap: butt; }
  .l-anilla { stroke: var(--l-cincha); stroke-width: 1.5px; fill: var(--l-fondo); }
  .l-rotulo {
    fill: var(--l-cota);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 9px;
    letter-spacing: .08em;
  }
  .l-guia { stroke: var(--l-cota); stroke-width: 1px; }
</style>
