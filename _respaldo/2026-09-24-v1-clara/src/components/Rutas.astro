---
import { DESTINOS, CARGAS, ORIGEN, VELOCIDAD_MEDIA, RECARGO_MARITIMO } from '../data/tarifas.js';

const moto = CARGAS.find((c) => c.id === 'moto');

// Cada una de estas filas es, a futuro, su propia pagina /rutas/madrid-x/.
// Por eso una sola pagina por par: "Madrid a Valencia" y "Valencia a Madrid"
// son la misma intencion de busqueda y dos paginas se canibalizarian.
const rutas = DESTINOS.map((d) => {
  const carretera = Math.max(moto.min, moto.base + d.km * moto.km);
  // Los km son los de carretera hasta el puerto. El ferry va aparte, igual
  // que en la calculadora: si no, Palma saldria mas barato que Murcia.
  const total = carretera + (d.maritimo ? RECARGO_MARITIMO : 0);
  return {
    ...d,
    horas: Math.max(1, Math.round(d.km / VELOCIDAD_MEDIA)),
    desde: Math.round(total / 5) * 5,
  };
}).sort((a, b) => a.desde - b.desde);
---

<section class="sec" id="rutas">
  <div class="wrap">
    <div class="sec-head rise">
      <p class="tag">03 &nbsp;/&nbsp; Rutas</p>
      <div>
        <h2 class="display h-lg">Todo sale de {ORIGEN}.<br />Por eso vuelve barato.</h2>
        <p class="lede" style="margin-top:1.1rem">
          Las radiales nacen aquí: cualquier ruta que toque {ORIGEN} tiene
          retorno. Eso abarata la vuelta y llena huecos que otros hacen vacíos.
        </p>
      </div>
    </div>

    <div class="tabla rise">
      <div class="tabla__head mono">
        <span>Destino</span>
        <span>Distancia</span>
        <span>En carretera</span>
        <span>Moto, desde</span>
      </div>

      <ul class="tabla__body">
        {rutas.map((r) => (
          <li class="fila">
            <span class="fila__d">
              <span class="fila__o mono">{ORIGEN}</span>
              <span class="fila__x" aria-hidden="true">&#8646;</span>
              {r.nombre}
              {r.maritimo ? <span class="badge">+ ferry</span> : r.nautico && <span class="badge">náutico</span>}
            </span>
            <span class="mono">{r.km.toLocaleString('es-ES')} km{r.maritimo ? ' + mar' : ''}</span>
            <span class="mono">~{r.horas} h</span>
            <span class="mono fila__p">{r.desde} &euro;</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="nota rise">
      Precios de referencia para una moto, solo ida. Un quad, un coche o un
      barco suben desde ahí. <strong>¿No ves tu destino?</strong> Se hace igual:
      esto son las salidas habituales, no el límite.
    </p>
  </div>
</section>

<style>
  .tabla {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line-strong);
  }
  .tabla__head {
    display: none;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .tabla__body { list-style: none; margin: 0; padding: 0; }

  .fila {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.4rem 1rem;
    padding: 1.05rem 0.6rem 1.05rem 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
    transition: background 0.2s var(--ease), padding-left 0.25s var(--ease);
  }
  .fila:hover { background: var(--paper-2); padding-left: 0.7rem; }

  .fila__d {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: clamp(1.05rem, 0.98rem + 0.4vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .fila__o { font-size: 0.78rem; font-weight: 400; color: var(--ink-3); }
  .fila__x { color: var(--ink-3); }
  .fila span.mono { font-size: 0.8rem; color: var(--ink-2); }
  .fila__p { font-weight: 600; color: var(--ink) !important; white-space: nowrap; }

  .badge {
    font-family: var(--f-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.16rem 0.42rem;
    background: var(--amber);
    color: var(--ink);
    transform: translateY(-2px);
  }

  @media (min-width: 760px) {
    .tabla__head,
    .fila {
      grid-template-columns: minmax(0, 1fr) 7rem 7.5rem 8rem;
      gap: 1rem;
    }
    .tabla__head { display: grid; }
    .fila span.mono { text-align: right; }
  }

  .nota {
    margin-top: 1.8rem;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--ink-3);
    max-width: 56ch;
  }
  .nota strong { color: var(--ink); font-weight: 600; }
</style>
