---
const TEL = '+34600000000';
const TEL_TXT = '600 000 000';
const WA = 'https://wa.me/34600000000';
---

<section class="cta" id="contacto">
  <div class="wrap cta__in">
    <div class="rise">
      <p class="tag">Presupuesto</p>
      <h2 class="display h-lg">
        Mándanos una foto<br />y el destino.
      </h2>
      <p class="lede" style="margin-top:1.2rem">
        No hacen falta medidas ni fichas técnicas. Con una foto de la moto o del
        barco y la ciudad a la que va, sale el precio cerrado el mismo día.
      </p>
    </div>

    <div class="cta__acc rise" style="--d:100ms">
      <a class="btn btn--amber cta__wa" href={WA}>
        Escribir por WhatsApp
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path
            d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
          />
        </svg>
      </a>
      <a class="btn btn--ghost cta__tel" href={`tel:${TEL}`}>Llamar {TEL_TXT}</a>
      <p class="cta__hr mono">Lunes a sábado · 7:00 &ndash; 21:00</p>
    </div>
  </div>
</section>

<footer class="pie">
  <div class="wrap">
    <div class="pie__top">
      <a class="pie__marca display" href="/">Calzo</a>
      <p class="pie__claim">
        Transporte de motos, quads y embarcaciones.<br />
        Madrid &middot; toda España.
      </p>
    </div>

    <div class="pie__cols">
      <div>
        <p class="tag">Qué movemos</p>
        <ul>
          <li><a href="#carga">Motos</a></li>
          <li><a href="#carga">Quads y UTV</a></li>
          <li><a href="#carga">Embarcaciones</a></li>
          <li><a href="#carga">Coches</a></li>
        </ul>
      </div>
      <div>
        <p class="tag">Cómo trabajamos</p>
        <ul>
          <li><a href="#parte">Parte de estado</a></li>
          <li><a href="#seguro">Seguro por valor declarado</a></li>
          <li><a href="#rutas">Rutas y salidas</a></li>
        </ul>
      </div>
      <div>
        <p class="tag">Contacto</p>
        <ul>
          <li><a href={WA}>WhatsApp</a></li>
          <li><a href={`tel:${TEL}`}>{TEL_TXT}</a></li>
          <li><a href="mailto:hola@calzo.es">hola@calzo.es</a></li>
        </ul>
      </div>
    </div>

    <div class="pie__fin mono">
      <span>&copy; {new Date().getFullYear()} Calzo</span>
      <span>Aviso legal &middot; Privacidad</span>
    </div>
  </div>
</footer>

<style>
  .cta { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .cta__in { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: end; }
  @media (min-width: 900px) {
    .cta__in { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); }
  }
  .cta .tag { margin: 0 0 1.3rem; }

  .cta__acc { display: grid; gap: 0.7rem; align-content: end; }
  .cta__wa, .cta__tel { justify-content: space-between; }
  .cta__hr { font-size: 0.7rem; color: var(--ink-3); margin: 0.5rem 0 0; }

  /* --- pie -------------------------------------------------------------- */

  .pie {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }
  .pie__top {
    display: grid;
    gap: 1.4rem;
    padding-bottom: 2.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 20%, transparent);
  }
  @media (min-width: 760px) {
    .pie__top { grid-template-columns: auto minmax(0, 1fr); align-items: end; gap: 3rem; }
  }
  .pie__marca {
    font-size: clamp(3.4rem, 2rem + 6vw, 6.5rem);
    font-weight: 900;
    font-stretch: 120%;
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-decoration: none;
    color: var(--paper);
  }
  .pie__claim {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--paper) 66%, transparent);
  }

  .pie__cols {
    display: grid;
    gap: 2.2rem;
    padding-block: 2.6rem;
  }
  @media (min-width: 620px) { .pie__cols { grid-template-columns: repeat(3, 1fr); } }
  .pie__cols .tag { color: color-mix(in srgb, var(--paper) 48%, transparent); margin: 0 0 1rem; }
  .pie__cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .pie__cols a {
    text-decoration: none;
    font-size: 0.93rem;
    color: color-mix(in srgb, var(--paper) 82%, transparent);
    transition: color 0.2s var(--ease);
  }
  .pie__cols a:hover { color: var(--amber); }

  .pie__fin {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 20%, transparent);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--paper) 52%, transparent);
  }
</style>
